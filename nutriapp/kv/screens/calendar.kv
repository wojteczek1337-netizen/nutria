#:import dp kivy.metrics.dp

<CalendarScreen>:
    md_bg_color: app.theme_cls.backgroundColor

    MDScrollView:
        size_hint: 1, 1

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(12)
            padding: dp(16), dp(16), dp(16), dp(16)
            size_hint_y: None
            height: self.minimum_height

            MDBoxLayout:
                orientation: "horizontal"
                spacing: dp(8)
                size_hint_y: None
                height: dp(48)

                MDButton:
                    style: "text"
                    size_hint_x: 0.18
                    on_release:
                        root.previous_day()

                    MDButtonText:
                        text: "<"

                MDButton:
                    style: "outlined"
                    size_hint_x: 0.64
                    on_release:
                        root.open_date_picker()

                    MDButtonText:
                        id: date_button_text
                        text: "Dzisiejsza data"

                MDButton:
                    style: "text"
                    size_hint_x: 0.18
                    on_release:
                        root.next_day()

                    MDButtonText:
                        text: ">"

            MDButton:
                style: "text"
                size_hint_y: None
                height: dp(40)
                on_release:
                    root.go_to_today()

                MDButtonText:
                    text: "Wróć do dzisiaj"

            MDButton:
                style: "filled"
                size_hint_y: None
                height: dp(48)
                on_release:
                    root.open_add_eaten_entry()

                MDButtonText:
                    text: "+ Dodaj zjedzony posiłek"

            MDButton:
                style: "outlined"
                size_hint_y: None
                height: dp(48)
                on_release:
                    root.open_add_planned_entry()

                MDButtonText:
                    text: "+ Zaplanuj posiłek"

            MDBoxLayout:
                id: add_panel_container
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

            Widget:
                size_hint_y: None
                height: dp(12) if root.confirm_delete_visible else 0

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(12)
                padding: dp(12)
                size_hint_y: None
                adaptive_height: True
                opacity: 1 if root.confirm_delete_visible else 0
                disabled: not root.confirm_delete_visible

                canvas.before:
                    Color:
                        rgba: app.theme_cls.primaryColor if root.confirm_delete_visible else (0, 0, 0, 0)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12), dp(12), dp(12), dp(12)]

                MDLabel:
                    text: "Czy na pewno chcesz usunąć ten wpis z kalendarza?"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(12)
                    size_hint_y: None
                    height: dp(44)

                    MDButton:
                        style: "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release:
                            root.cancel_delete_entry()

                        MDButtonText:
                            text: "Anuluj"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                    MDButton:
                        style: "filled"
                        theme_width: "Custom"
                        size_hint_x: 1
                        md_bg_color: 1, 1, 1, 1
                        on_release:
                            root.confirm_delete_entry()

                        MDButtonText:
                            text: "Usuń na pewno"
                            theme_text_color: "Custom"
                            text_color: 0.2, 0.2, 0.2, 1

            MDLabel:
                text: "Posiłki w tym dniu"
                bold: True
                size_hint_y: None
                height: dp(26)

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDList:
                    id: entries_list

            MDLabel:
                text: "Podsumowanie dnia"
                bold: True
                size_hint_y: None
                height: dp(26)

            MDLabel:
                id: day_macros_value
                text: root.day_macros_text
                adaptive_height: True
                text_size: self.width, None

            Widget:
                size_hint_y: None
                height: dp(16)