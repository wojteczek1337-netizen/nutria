#:import dp kivy.metrics.dp

<UserPointsScreen>:
    md_bg_color: app.theme_cls.backgroundColor

    MDScrollView:
        do_scroll_x: False

        MDBoxLayout:
            orientation: "vertical"
            padding: dp(16)
            spacing: dp(12)
            size_hint_y: None
            height: self.minimum_height

            MDLabel:
                id: summary_label
                text: "Suma: 0 punktów"
                adaptive_height: True

            MDLabel:
                id: hint_label
                text: ""
                theme_text_color: "Secondary"
                adaptive_height: True

            MDList:
                id: days_list
                size_hint_y: None
                height: self.minimum_height
