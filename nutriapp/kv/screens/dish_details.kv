#:import dp kivy.metrics.dp

<DishDetailsScreen>:
    md_bg_color: app.theme_cls.backgroundColor

    MDScrollView:
        size_hint: 1, 1

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(10)
            padding: dp(16), dp(16), dp(16), dp(16)
            size_hint_y: None
            height: self.minimum_height

            MDLabel:
                text: "Nazwa"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: name_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Opis"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: description_value
                text: "-"
                adaptive_height: True
                text_size: self.width, None

            MDLabel:
                text: "Przepis"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: recipe_value
                text: "-"
                adaptive_height: True
                text_size: self.width, None

            MDLabel:
                text: "Tutorial YouTube"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: youtube_value
                text: "-"
                adaptive_height: True
                text_size: self.width, None

            MDLabel:
                text: "Składniki"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: ingredients_value
                text: "-"
                adaptive_height: True
                text_size: self.width, None

            MDLabel:
                text: "Makro całego posiłku"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: macros_value
                text: "-"
                adaptive_height: True
                text_size: self.width, None

            Widget:
                size_hint_y: None
                height: dp(8)

            MDBoxLayout:
                orientation: "horizontal"
                spacing: dp(12)
                size_hint_y: None
                height: dp(44)

                MDButton:
                    style: "filled"
                    on_release:
                        root.open_edit_dish()

                    MDButtonText:
                        text: "Edytuj"

                MDButton:
                    style: "outlined"
                    on_release:
                        root.show_delete_confirmation()

                    MDButtonText:
                        text: "Usuń"

            Widget:
                size_hint_y: None
                height: dp(12) if root.confirm_delete_visible else 0

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(12)
                padding: dp(12)
                size_hint_y: None
                adaptive_height: True
                opacity: 1 if root.confirm_delete_visible else 0
                disabled: not root.confirm_delete_visible

                canvas.before:
                    Color:
                        rgba: app.theme_cls.primaryColor if root.confirm_delete_visible else (0, 0, 0, 0)

                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12), dp(12), dp(12), dp(12)]

                MDLabel:
                    text: "Czy na pewno chcesz usunąć to danie?"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(12)
                    size_hint_y: None
                    height: dp(44)

                    MDButton:
                        style: "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release:
                            root.hide_delete_confirmation()

                        MDButtonText:
                            text: "Anuluj"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                    MDButton:
                        style: "filled"
                        theme_width: "Custom"
                        size_hint_x: 1
                        md_bg_color: 1, 1, 1, 1
                        on_release:
                            root.confirm_delete_dish()

                        MDButtonText:
                            text: "Usuń na pewno"
                            theme_text_color: "Custom"
                            text_color: 0.2, 0.2, 0.2, 1