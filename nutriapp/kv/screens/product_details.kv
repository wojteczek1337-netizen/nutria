#:import dp kivy.metrics.dp

<ProductDetailsScreen>:
    md_bg_color: app.theme_cls.backgroundColor

    MDScrollView:
        size_hint: 1, 1

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(10)
            padding: dp(16), dp(16), dp(16), dp(16)
            size_hint_y: None
            height: self.minimum_height

            MDLabel:
                text: "Nazwa"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: name_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Marka"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: brand_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Opis porcji / opakowania"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: quantity_text_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Waga"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: quantity_g_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Kalorie / 100 g"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: energy_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Białko / 100 g"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: protein_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Tłuszcz / 100 g"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: fat_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Kwasy nasycone / 100 g"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: saturated_fat_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Węglowodany / 100 g"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: carbs_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Cukry / 100 g"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: sugar_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Błonnik / 100 g"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: fiber_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Sól / 100 g"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: salt_value
                text: "-"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Skład"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: ingredients_value
                text: "-"
                adaptive_height: True
                text_size: self.width, None

            MDLabel:
                text: "Alergeny"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: allergens_value
                text: "-"
                adaptive_height: True
                text_size: self.width, None

            MDLabel:
                text: "Tagi"
                bold: True
                size_hint_y: None
                height: dp(22)

            MDLabel:
                id: tags_value
                text: "Wkrótce"
                size_hint_y: None
                height: self.texture_size[1]

            Widget:
                size_hint_y: None
                height: dp(8)

            MDBoxLayout:
                orientation: "horizontal"
                spacing: dp(12)
                size_hint_y: None
                height: dp(44)

                MDButton:
                    style: "filled"
                    on_release:
                        root.open_edit_product()

                    MDButtonText:
                        text: "Edytuj"

                MDButton:
                    style: "outlined"
                    on_release:
                        root.show_delete_confirmation()

                    MDButtonText:
                        text: "Usuń"

            Widget:
                size_hint_y: None
                height: dp(12) if root.confirm_delete_visible else 0

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(12)
                padding: dp(12)
                size_hint_y: None
                adaptive_height: True
                opacity: 1 if root.confirm_delete_visible else 0
                disabled: not root.confirm_delete_visible

                canvas.before:
                    Color:
                        rgba: app.theme_cls.primaryColor if root.confirm_delete_visible else (0, 0, 0, 0)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12), dp(12), dp(12), dp(12)]

                MDLabel:
                    text: "Czy na pewno chcesz usunąć ten produkt?"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(12)
                    size_hint_y: None
                    height: dp(44)

                    MDButton:
                        style: "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release:
                            root.hide_delete_confirmation()

                        MDButtonText:
                            text: "Anuluj"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                    MDButton:
                        style: "filled"
                        theme_width: "Custom"
                        size_hint_x: 1
                        md_bg_color: 1, 1, 1, 1
                        on_release:
                            root.confirm_delete_product()

                        MDButtonText:
                            text: "Usuń na pewno"
                            theme_text_color: "Custom"
                            text_color: 0.2, 0.2, 0.2, 1