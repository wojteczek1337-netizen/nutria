#:import dp kivy.metrics.dp

<DietListScreen>:
    md_bg_color: app.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        MDButton:
            style: "filled"
            size_hint_y: None
            height: dp(48)
            on_release:
                root.create_new_diet()

            MDButtonText:
                text: "+ Nowa dieta"

        MDLabel:
            text: "Twoje diety"
            bold: True
            size_hint_y: None
            height: dp(26)

        MDScrollView:
            size_hint_y: 1

            MDBoxLayout:
                id: diets_list_container
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height