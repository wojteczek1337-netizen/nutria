# Hasło bazy: Supabase -> Project Settings -> Database -> Database password.
# Zamień [YOUR-PASSWORD]. Jeśli hasło zawiera znaki @ : / # %, zostaw
# [YOUR-PASSWORD] w DATABASE_URL i wpisz hasło osobno w DB_PASSWORD.
#
# Pula sesji (IPv4). Bezpośredni host db.<ref>.supabase.co:5432 jest tylko IPv6
# i na tym komputerze jest nieosiągalny.
DATABASE_URL=postgresql://postgres.ohvfydjzkowjnjydeaew:YOUR-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
